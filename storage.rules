rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Izinkan pengguna mengunggah dan membaca foto profil mereka sendiri
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true; // Semua orang bisa melihat foto profil
      allow write: if request.auth != null && request.auth.uid == userId; // Hanya pemilik yang bisa ganti foto
    }
  }
}
